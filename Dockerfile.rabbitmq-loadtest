FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements-loadtest.txt /app/requirements-loadtest.txt
RUN pip install --no-cache-dir -r /app/requirements-loadtest.txt

COPY src/__init__.py /app/src/__init__.py
COPY src/modules/__init__.py /app/src/modules/__init__.py
COPY src/modules/load_testing /app/src/modules/load_testing
COPY scripts/testing/run_rabbitmq_discord_bot_benchmark.py /app/scripts/testing/run_rabbitmq_discord_bot_benchmark.py

ENTRYPOINT ["python", "-u", "scripts/testing/run_rabbitmq_discord_bot_benchmark.py"]
