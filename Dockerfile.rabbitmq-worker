FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
COPY requirements-rabbitmq-worker.txt /app/requirements-rabbitmq-worker.txt
RUN pip install --no-cache-dir -r /app/requirements-rabbitmq-worker.txt
RUN pip install --no-cache-dir psycopg2-binary==2.9.11

COPY alembic.ini /app/alembic.ini
COPY alembic /app/alembic
COPY configs /app/configs
COPY src /app/src
COPY scripts/testing/run_rabbitmq_moderation_worker.py /app/scripts/testing/run_rabbitmq_moderation_worker.py

ENTRYPOINT ["python", "-u", "scripts/testing/run_rabbitmq_moderation_worker.py"]
